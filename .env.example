# Token PUBLIC Mapbox utilisé par mapbox-gl côté client (carte/style/tuiles).
# Récupérer sur https://account.mapbox.com/access-tokens/
# IMPORTANT : Restreindre ce token via une URL allowlist sur le compte Mapbox
# (https://docs.mapbox.com/accounts/guides/tokens/#url-restrictions)
# pour éviter qu'il soit réutilisé sur d'autres domaines.
VITE_MAPBOX_PUBLIC_TOKEN=pk.your_public_token_here

# (Optionnel) Base URL du proxy Cloudflare Worker en production.
# En dev, laisser vide : Vite proxie /api → http://127.0.0.1:8787 (wrangler dev).
# Exemple prod : https://mapbox-3d-proxy.<account>.workers.dev
VITE_API_BASE_URL=
